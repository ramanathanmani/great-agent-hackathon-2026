# Freshdesk Configuration (Required for api/create-ticket.js)
FRESHDESK_DOMAIN=your-company.freshdesk.com # Your Freshdesk domain (without https://)
FRESHDESK_API_KEY=your_freshdesk_api_key    # Freshdesk API key for ticket creation

# Gemini API Configuration (Optional — used for live LLM understanding in index.html)
GEMINI_API_KEY=AIzaSy...                    # Google Gemini API key

# CORS Allowed Origin (Optional — default is * in development, specify production domain in prod)
ALLOWED_ORIGIN=https://codemix-skill.vercel.app # Origin allowlist for Vercel serverless API
